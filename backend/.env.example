APP_ENV=local
LOG_LEVEL=info

# Postgres runs in Docker -- use localhost + whatever host port
# your docker-compose.yml maps (see README/setup PDF if you changed it).
DATABASE_URL=postgresql://prism:prism@localhost:5433/prism

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=prism_repo_index

# --- GitHub ---
# Webhook secret: any random string, must match EXACTLY what you enter
# on GitHub's webhook config page. Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=changeme

# Fine-grained Personal Access Token, scoped to your own test repo only.
# Needs: Pull requests (Read), Contents (Read), Issues (Read and write).
GITHUB_API_TOKEN=

# --- LLM provider (pick one; PRISM currently uses Groq) ---
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
